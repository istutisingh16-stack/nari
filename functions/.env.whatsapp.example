# Non-secret configuration. Merge into functions/.env; do not overwrite SITE_URL.
# Keep false until your account's native payments eligibility and end-to-end tests are confirmed.
WA_ENABLED=false
# Use a supported Graph API version from your Meta app dashboard, e.g. vNN.0.
WA_GRAPH_VERSION=
WA_BUSINESS_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
# The gateway linked to WhatsApp Manager: razorpay, payu, billdesk or zaakpay.
WA_PAYMENT_GATEWAY=
WA_PAYMENT_CONFIGURATION=
# Set WA_ACCESS_TOKEN, WA_APP_SECRET and WA_VERIFY_TOKEN with Firebase Secret Manager.
# Never put those secrets in portal-config.js, HTML, client JavaScript or Git.
