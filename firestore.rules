rules_version = '2';
// ===== NARI Health — Firestore security rules =====
// Paste into Firebase console → Firestore Database → Rules, or deploy with
// `firebase deploy --only firestore:rules`. These rules are what actually
// protects member data; the browser code is not trusted.
//
// Collections
//   doctors/{doctorId}      public profile of a panel doctor (no email, no password)
//   staff/{email}           { role: 'admin' | 'doctor', doctorId?, name }  — who may sign in as staff
//   members/{uid}           one document per signed-in member, keyed by their Firebase uid
//   invites/{phone}         a member added by a doctor before she signs up herself
//   appointments/{id}       bookings; member details are copied on so doctors never read /members
//   leads/{id}              website call-back enquiries (no sign-in); admins only
//
// Members sign in with Google and then verify their mobile number by SMS code. The number is linked
// to the same account, so request.auth.token.phone_number is present for every real member. Rules
// below require it before a member can save a profile or book, and use it to match doctor invites.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A member who has completed the SMS step (Google-only accounts have no phone_number claim yet).
    function phoneVerified() { return signedIn() && 'phone_number' in request.auth.token && request.auth.token.phone_number is string; }
    // The 10-digit number saved on a profile must be the one verified on the account.
    function phoneMatchesToken(p) { return p is string && p.matches('^[0-9]{10}$') && request.auth.token.phone_number.matches('^\\+[0-9]*' + p + '$'); }
    // Staff sign in with email + password (created by an admin) or with Google.
    function hasEmail() {
      return signedIn() && request.auth.token.email is string
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }
    function myEmail() { return request.auth.token.email; }
    function isStaff() { return hasEmail() && exists(/databases/$(database)/documents/staff/$(myEmail())); }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(myEmail())).data; }
    function isAdmin() { return isStaff() && staffDoc().role == 'admin'; }
    function isDoctor() { return isStaff() && staffDoc().role == 'doctor'; }
    function myDoctorId() { return staffDoc().doctorId; }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    // The invite belongs to the signed-in person if her verified phone or her account email matches.
    function inviteIsMine() {
      return signedIn() && (
        (phoneVerified() && resource.data.phoneE164 == request.auth.token.phone_number)
        || ('email' in request.auth.token && resource.data.email is string && resource.data.email != '' && resource.data.email == request.auth.token.email)
      );
    }

    // Doctors are public so the booking form and referral links work before sign-in.
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A person may read their own staff record (to learn their role); only admins manage the list.
    match /staff/{email} {
      allow read: if isAdmin() || (hasEmail() && myEmail() == email);
      allow write: if isAdmin();
    }

    // Members own their profile. Admins can read everyone (for the console).
    // Writing a profile needs the SMS-verified number, and the saved phone must be that number.
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if phoneVerified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'name', 'phone', 'email', 'city', 'img', 'provider', 'createdAt', 'referredByDoctorId'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && phoneMatchesToken(request.resource.data.phone);
      allow delete: if isAdmin();
    }

    // Doctors add members; the member later claims the invite when she signs in.
    match /invites/{phone} {
      allow read: if isAdmin() || (isDoctor() && resource.data.doctorId == myDoctorId()) || inviteIsMine();
      allow create: if isAdmin()
        || (isDoctor() && request.resource.data.doctorId == myDoctorId() && request.resource.data.phone == phone && request.resource.data.claimedBy == null);
      allow update: if isAdmin()
        || (isDoctor() && resource.data.doctorId == myDoctorId())
        || (inviteIsMine() && resource.data.claimedBy == null && onlyChanges(['claimedBy', 'claimedAt']) && request.resource.data.claimedBy == request.auth.uid);
      allow delete: if isAdmin() || (isDoctor() && resource.data.doctorId == myDoctorId());
    }

    // Website enquiries ("Get a free call back" on the public pages). Anyone may create one, with strict
    // shape and size checks; only admins can read or change them. The browser also uses a honeypot field.
    match /leads/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id', 'name', 'phone', 'concern', 'time', 'page', 'ref', 'utm', 'status', 'createdAt'])
        && request.resource.data.id == id
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.concern is string && request.resource.data.concern.size() <= 60
        && request.resource.data.time in ['morning', 'afternoon', 'evening']
        && request.resource.data.page is string && request.resource.data.page.size() <= 60
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 20
        && request.resource.data.utm is map && request.resource.data.utm.keys().hasOnly(['source', 'medium', 'campaign'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
    }

    match /appointments/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.memberId == request.auth.uid)
        || (isDoctor() && (resource.data.doctorId == myDoctorId() || resource.data.referredDoctorId == myDoctorId()));

      // Members create their own bookings, always starting as pending. Only members with a verified number can book.
      allow create: if isAdmin()
        || (phoneVerified() && request.resource.data.memberId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000);

      // Members may only cancel. Doctors may change the status of their own consultations. Admins may do anything.
      allow update: if isAdmin()
        || (signedIn() && resource.data.memberId == request.auth.uid && onlyChanges(['status']) && request.resource.data.status == 'cancelled')
        || (isDoctor() && resource.data.doctorId == myDoctorId() && onlyChanges(['status']));

      allow delete: if isAdmin();
    }
  }
}
