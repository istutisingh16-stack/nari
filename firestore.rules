rules_version = '2';
// ===== NARI Health — Firestore security rules =====
// Paste into Firebase console → Firestore Database → Rules, or deploy with
// `firebase deploy --only firestore:rules`. These rules are what actually
// protects member data; the browser code is not trusted.
//
// Collections
//   doctors/{doctorId}      public profile of a panel doctor (no email, no password)
//   staff/{email}           { role: 'admin' | 'doctor', doctorId?, name }  — who may sign in as staff
//   members/{uid}           one document per signed-in member, keyed by their Firebase uid
//   invites/{phone}         a member added by a doctor before she signs up herself
//   appointments/{id}       bookings; member details are copied on so doctors never read /members
//   leads/{id}              website call-back enquiries (no sign-in); admins only
//   payments/{id}           a member's Paytm payment attempt for a plan; she may add the UPI reference,
//                           only admins can mark it paid/failed
//   cycles/{uid}            a member's period tracker; readable and writable by her alone
//   pushTokens/{token}      a staff member's device token for push notifications (Cloud Messaging)
//   traffic/{YYYY-MM-DD}    page-view counters written by traffic.js without sign-in; admins read them
//
// Members sign in with their mobile number + SMS code only, so request.auth.token.phone_number is
// present for every real member. Rules below require it before a member can save a profile, book or
// pay, and use it to match doctor invites.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A member who has completed the SMS step (staff Google/password accounts have no phone_number claim).
    function phoneVerified() { return signedIn() && 'phone_number' in request.auth.token && request.auth.token.phone_number is string; }
    // The 10-digit number saved on a profile must be the one verified on the account.
    function phoneMatchesToken(p) { return p is string && p.matches('^[0-9]{10}$') && request.auth.token.phone_number.matches('^\\+[0-9]*' + p + '$'); }
    // Staff sign in with email + password (created by an admin) or with Google.
    function hasEmail() {
      return signedIn() && request.auth.token.email is string
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }
    function myEmail() { return request.auth.token.email; }
    function isStaff() { return hasEmail() && exists(/databases/$(database)/documents/staff/$(myEmail())); }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(myEmail())).data; }
    function isAdmin() { return isStaff() && staffDoc().role == 'admin'; }
    function isDoctor() { return isStaff() && staffDoc().role == 'doctor'; }
    function myDoctorId() { return staffDoc().doctorId; }
    function onlyChanges(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    // The invite belongs to the signed-in person if her verified phone or her account email matches.
    function inviteIsMine() {
      return signedIn() && (
        (phoneVerified() && resource.data.phoneE164 == request.auth.token.phone_number)
        || ('email' in request.auth.token && resource.data.email is string && resource.data.email != '' && resource.data.email == request.auth.token.email)
      );
    }

    // Doctors are public so the booking form and referral links work before sign-in.
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A person may read their own staff record (to learn their role); only admins manage the list.
    // Anyone on it may stamp two markers on their own record: first sign-in and "notifications seen up to".
    match /staff/{email} {
      allow read: if isAdmin() || (hasEmail() && myEmail() == email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (hasEmail() && myEmail() == email && onlyChanges(['firstLoginAt', 'notifSeenAt']));
    }

    // Members own their profile. Admins can read everyone (for the console).
    // Writing a profile needs the SMS-verified number, and the saved phone must be that number.
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if phoneVerified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'name', 'phone', 'email', 'city', 'img', 'provider', 'createdAt', 'referredByDoctorId'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && phoneMatchesToken(request.resource.data.phone);
      allow delete: if isAdmin();
    }

    // Doctors add members; the member later claims the invite when she signs in.
    match /invites/{phone} {
      allow read: if isAdmin() || (isDoctor() && resource.data.doctorId == myDoctorId()) || inviteIsMine();
      allow create: if isAdmin()
        || (isDoctor() && request.resource.data.doctorId == myDoctorId() && request.resource.data.phone == phone && request.resource.data.claimedBy == null);
      allow update: if isAdmin()
        || (isDoctor() && resource.data.doctorId == myDoctorId())
        || (inviteIsMine() && resource.data.claimedBy == null && onlyChanges(['claimedBy', 'claimedAt']) && request.resource.data.claimedBy == request.auth.uid);
      allow delete: if isAdmin() || (isDoctor() && resource.data.doctorId == myDoctorId());
    }

    // Website enquiries ("Get a free call back" on the public pages). Anyone may create one, with strict
    // shape and size checks; only admins can read or change them. The browser also uses a honeypot field.
    match /leads/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['id', 'name', 'phone', 'concern', 'time', 'page', 'ref', 'utm', 'status', 'createdAt'])
        && request.resource.data.id == id
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.concern is string && request.resource.data.concern.size() <= 60
        && request.resource.data.time in ['morning', 'afternoon', 'evening']
        && request.resource.data.page is string && request.resource.data.page.size() <= 60
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 20
        && request.resource.data.utm is map && request.resource.data.utm.keys().hasOnly(['source', 'medium', 'campaign'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
    }

    match /appointments/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.memberId == request.auth.uid)
        || (isDoctor() && (resource.data.doctorId == myDoctorId() || resource.data.referredDoctorId == myDoctorId()));

      // Members create their own bookings, always starting as pending. Only members with a verified number can book.
      allow create: if isAdmin()
        || (phoneVerified() && request.resource.data.memberId == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000);

      // Members may only cancel. Doctors may change the status of their own consultations. Admins may do anything.
      // (cancelledAt is stamped alongside a cancellation so the team's activity feed can order it.)
      allow update: if isAdmin()
        || (signedIn() && resource.data.memberId == request.auth.uid && onlyChanges(['status', 'cancelledAt']) && request.resource.data.status == 'cancelled')
        || (isDoctor() && resource.data.doctorId == myDoctorId() && onlyChanges(['status', 'cancelledAt']));

      allow delete: if isAdmin();
    }

    // Payments. A member records her own attempt (status 'initiated', amount and plan copied from the page),
    // then may only add the UPI reference and move it to 'claimed'. Admins verify against the Paytm
    // statement and set 'paid' / 'failed' / 'refunded'.
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isAdmin()
        || (phoneVerified() && request.resource.data.memberId == request.auth.uid
            && request.resource.data.keys().hasOnly(['id', 'memberId', 'memberName', 'memberPhone', 'planId', 'planLabel', 'amount', 'recurring', 'status', 'txnRef', 'createdAt'])
            && request.resource.data.id == id
            && request.resource.data.status == 'initiated'
            && request.resource.data.planId is string && request.resource.data.planId.size() <= 20
            && request.resource.data.planLabel is string && request.resource.data.planLabel.size() <= 60
            && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
            && request.resource.data.recurring is bool
            && request.resource.data.txnRef == ''
            && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40);
      allow update: if isAdmin()
        || (signedIn() && resource.data.memberId == request.auth.uid && resource.data.status == 'initiated'
            && onlyChanges(['status', 'txnRef', 'claimedAt'])
            && request.resource.data.status == 'claimed'
            && request.resource.data.txnRef is string && request.resource.data.txnRef.size() >= 6 && request.resource.data.txnRef.size() <= 40);
      allow delete: if isAdmin();
    }

    // Period tracker. Health data: the member alone can read or write it. Admins can only delete it when
    // removing her account. Which members see the tracker (paid plans) is decided in the browser; the data
    // itself is private either way.
    match /cycles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if phoneVerified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'memberId', 'periods', 'logs', 'cycleLength', 'updatedAt'])
        && request.resource.data.id == uid && request.resource.data.memberId == uid
        && request.resource.data.periods is list && request.resource.data.periods.size() <= 120
        && request.resource.data.logs is map && request.resource.data.logs.size() <= 400;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Push-notification device tokens. A staff member registers her own devices; admins see them all
    // (the console lists enabled devices) and may remove any. The Cloud Function reads them server-side.
    match /pushTokens/{token} {
      allow read: if isAdmin();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['id', 'token', 'email', 'role', 'name', 'device', 'createdAt', 'updatedAt'])
        && request.resource.data.id == token && request.resource.data.token == token
        && request.resource.data.email == myEmail()
        && request.resource.data.role == staffDoc().role;
      allow delete: if isAdmin() || (isStaff() && resource.data.email == myEmail());
    }

    // Page-view counters for the developer page. Written by anyone (no sign-in) one view at a time via
    // Firestore's increment transform; the row shape and sizes are pinned so nothing else can be stored here.
    // Like any public counter it could be inflated on purpose; Google Analytics remains the audited source.
    match /traffic/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && trafficShape() && request.resource.data.views == 1;
      allow update: if trafficShape() && request.resource.data.views == resource.data.views + 1;
      allow delete: if isAdmin();
    }
    function trafficShape() {
      let d = request.resource.data;
      return d.keys().hasOnly(['day', 'views', 'visitors', 'pages', 'sources', 'devices', 'hours', 'campaigns'])
        && d.day is string && d.day.size() == 10
        && d.views is int && d.views <= 5000000
        && (!('visitors' in d) || d.visitors is int)
        && (!('pages' in d) || (d.pages is map && d.pages.size() <= 60))
        && (!('sources' in d) || (d.sources is map && d.sources.size() <= 200))
        && (!('devices' in d) || (d.devices is map && d.devices.size() <= 4))
        && (!('hours' in d) || (d.hours is map && d.hours.size() <= 24))
        && (!('campaigns' in d) || (d.campaigns is map && d.campaigns.size() <= 100));
    }
  }
}
